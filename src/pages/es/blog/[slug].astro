---
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/sections/Header.astro';
import Footer from '../../../components/sections/Footer.astro';
import BlogCTA from '../../../components/blog/BlogCTA.astro';
import { Image, getImage } from 'astro:assets';
import { fetchStrapi, blocksToHtml } from '../../../lib/strapi';
import type { Article, StrapiListResponse } from '../../../lib/strapi';
import { translations } from '../../../i18n/translations';
import { buildPageTitle } from '../../../lib/seo';
import blogImg1 from '../../../assets/blog/1.webp';
import blogImg2 from '../../../assets/blog/2.webp';
import blogImg3 from '../../../assets/blog/3.webp';
const numberedFallbacks = [blogImg1, blogImg2, blogImg3];
const blogImages = import.meta.glob<{ default: ImageMetadata }>('../../../assets/blog/*.webp', { eager: true });

const t = translations.es;

export async function getStaticPaths() {
  const { data: articles } = await fetchStrapi<StrapiListResponse<Article>>(
    '/articles?sort=publishedAt:desc&fields[0]=slug&fields[1]=title&pagination[pageSize]=100&locale=es'
  );
  return articles.map((article, i) => ({
    params: { slug: article.slug },
    props: { article, articleIndex: i },
  }));
}

const { slug } = Astro.params;
const { articleIndex } = Astro.props;

const { data: articles } = await fetchStrapi<StrapiListResponse<Article>>(
  `/articles?filters[slug][$eq]=${slug}&populate=image&populate=localizations&pagination[pageSize]=1&locale=es`
);

const article = articles[0];

if (!article) return Astro.redirect('/es/blog/');

const idx = typeof articleIndex === 'number' ? articleIndex : 0;
const cover: ImageMetadata = blogImages[`../../../assets/blog/${article.slug}.webp`]?.default
  ?? blogImages[`../../../assets/blog/${(idx % 6) + 1}.webp`]?.default
  ?? numberedFallbacks[idx % 3]
  ?? blogImg1;

// The hero backdrop and the featured image below it are the same picture, and
// the sources run 4000-6000px wide (up to 1.9 MB), so they go through <Image>
// rather than a raw <img src>. Identical widths and sizes on both elements
// resolve to the same srcset candidate: one download, not two.
//
// `width` is pinned deliberately. Without it Astro builds the non-srcset
// fallback `src` from the full-size source, shipping a ~2 MB file that only
// crawlers and srcset-less clients ever read.
const COVER_WIDTHS = [640, 1024, 1536];
const COVER_MAX_WIDTH = 1536;
const COVER_HEIGHT = Math.round((COVER_MAX_WIDTH * cover.height) / cover.width);
const COVER_SIZES = '(min-width: 768px) 768px, 100vw';

// og:image needs a URL string, not an element, so it gets its own transform.
const ogImage = (await getImage({ src: cover, width: 1200 })).src;

const contentHtml = blocksToHtml(article.content);

// hreflang pair comes from Strapi i18n, never from slug guessing: the two
// locales use different slugs. No linked translation means no hreflang.
const translatedSlug = article.localizations?.[0]?.slug ?? null;
const alternatePath = translatedSlug ? `/blog/${translatedSlug}/` : null;

const articleSchema = article ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description ?? article.title,
  image: ogImage,
  datePublished: article.publishedAt,
  publisher: {
    '@type': 'Organization',
    name: 'Graduacions.cat',
    url: 'https://www.graduacions.cat',
  },
} : null;
---

<Layout
  title={buildPageTitle(article.title)}
  description={article.description ?? article.title}
  lang="es"
  skipToContent={t.layout.skipToContent}
  image={ogImage}
  alternatePath={alternatePath}
>
  {articleSchema && (
    <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  )}
  <Header t={t.header} lang="es" />

  <main id="main-content">

    <div class="relative bg-brand pt-24 pb-0">

      {cover ? (
        <>
          <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
            <Image
              src={cover}
              alt={article.image?.alternativeText ?? article.title}
              widths={COVER_WIDTHS}
              sizes={COVER_SIZES}
              width={COVER_MAX_WIDTH}
              height={COVER_HEIGHT}
              class="w-full h-full object-cover opacity-20"
              loading="eager"
            />
          </div>
          <div class="relative max-w-3xl mx-auto px-6 pt-8 pb-16 text-center">
            <a href="/es/blog/" class="inline-flex items-center gap-1.5 text-white/60 hover:text-white text-sm font-medium transition-colors mb-6">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
              </svg>
              Volver al blog
            </a>
            <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-4">{article.title}</h1>
            {article.publishedAt && (
              <time datetime={article.publishedAt} class="text-white/60 text-sm">
                {new Date(article.publishedAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            )}
          </div>
        </>
      ) : (
        <div class="relative max-w-3xl mx-auto px-6 pt-8 pb-16 text-center">
          <a href="/es/blog/" class="inline-flex items-center gap-1.5 text-white/60 hover:text-white text-sm font-medium transition-colors mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Volver al blog
          </a>
          <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-4">{article.title}</h1>
          {article.publishedAt && (
            <time datetime={article.publishedAt} class="text-white/60 text-sm">
              {new Date(article.publishedAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          )}
        </div>
      )}

      <svg viewBox="0 0 1440 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="block w-full -mb-1">
        <path d="M0 40 C360 0 1080 0 1440 40 L1440 40 L0 40 Z" fill="white"/>
      </svg>
    </div>

    {cover && (
      <div class="max-w-3xl mx-auto px-6 -mt-6 mb-10 relative z-10">
        <Image
          src={cover}
          alt={article.image?.alternativeText ?? article.title}
          widths={COVER_WIDTHS}
          sizes={COVER_SIZES}
          width={COVER_MAX_WIDTH}
          height={COVER_HEIGHT}
          class="w-full rounded-2xl object-cover max-h-80 shadow-lg"
          loading="eager"
          fetchpriority="high"
          transition:name={`post-image-es-${article.slug}`}
        />
      </div>
    )}

    <article class="max-w-3xl mx-auto px-6 pb-20">
      <div class="prose prose-lg max-w-none
        prose-headings:text-brand prose-headings:font-bold
        prose-a:text-brand prose-a:no-underline hover:prose-a:underline
        prose-strong:text-gray-900
        prose-blockquote:border-brand prose-blockquote:text-gray-600
        prose-code:text-brand-dark prose-code:bg-gray-50 prose-code:px-1 prose-code:rounded
        text-gray-700">
        <Fragment set:html={contentHtml} />
      </div>

      <BlogCTA t={t.hero} />

      <div class="mt-0 pt-8 border-t border-gray-100">
        <a
          href="/es/blog/"
          class="inline-flex items-center gap-2 text-sm font-semibold text-brand hover:text-brand-light transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Ver todos los artículos
        </a>
      </div>
    </article>

  </main>

  <Footer t={t.footer} />
</Layout>
